# ==============================================================================
# Production Next.js Docker Stack Environment Variables Template
# Stack location: prod/docker-compose.yml
# Copy to prod/.env for deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Traefik Reverse Proxy Configuration
# ------------------------------------------------------------------------------
DOMAIN_NAME=shop.meetjamali.com
DOCKER_NETWORK=my_network
CERT_RESOLVER=myresolver

# ------------------------------------------------------------------------------
# 2. Next.js Container & CI/CD Configuration
# ------------------------------------------------------------------------------
IMAGE_NAME=ghcr.io/bigboss248/nextjs-wordpress
IMAGE_TAG=latest
CONTAINER_NAME=nextjs-standalone-app
HOSTNAME=nextjs-app
PORT=3000

# Next.js URLs (Using unified shop.meetjamali.com domain to eliminate CORS and share session cookies)
NEXT_PUBLIC_BASE_URL=https://shop.meetjamali.com
NEXT_PUBLIC_WORDPRESS_API_URL=https://shop.meetjamali.com/graphql
NEXT_PUBLIC_WORDPRESS_URL=https://shop.meetjamali.com

# Server Action Encryption & Telemetry
# Generate key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
NEXT_PUBLIC_ENABLE_WEB_VITALS=true
OTEL_SDK_DISABLED=true
